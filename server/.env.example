# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/hostel-management

# JSON Web Token (JWT) secret key for signing tokens
JWT_SECRET=your_jwt_secret

# Server port
PORT=5000

# Node environment (development, production, etc.)
NODE_ENV=development

# Optional: Set a salt round number for bcrypt (used for password hashing)
BCRYPT_SALT_ROUNDS=10

# Optional: Set the URL of your frontend (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Optional: Set the log level for morgan or other logging libraries
LOG_LEVEL=dev

# Example: SMTP configuration for sending emails (if needed)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
